generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  age       Int?
  createdAt DateTime @default(now())

  @@map("users")
}

model Video {
  id       String  @id @default(cuid())
  title    String
  channel  String?
  cover    String
  duration String
  views    String
  url      String
}
